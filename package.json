{
  "name": "concurrent-ai-agents-runtime",
  "version": "1.0.0",
  "description": "High-Throughput Concurrent Multi-Agent Runtime & Parallel DAG Workflow Engine for Enterprise Analytics",
  "author": "Lucas Calado <lucascalado@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "start": "node dist/demo.js",
    "demo": "tsx src/demo.ts",
    "benchmark": "tsx src/benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai-agents",
    "concurrent-runtime",
    "dag",
    "parallel-workflows",
    "opentelemetry",
    "fan-out-fan-in",
    "worker-pool",
    "distributed-systems",
    "typescript"
  ],
  "dependencies": {
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
